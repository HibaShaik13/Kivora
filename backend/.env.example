# ==============================================================================
# Kivora Environment Variables Template (.env.example)
# Safe placeholder configuration for local development and testing.
# Copy to backend/.env and replace placeholders with actual local values.
# NEVER commit backend/.env or expose sensitive production credentials.
# ==============================================================================

KIVORA_ENV=development
SECRET_KEY=replace_with_a_random_secure_secret_key_at_least_32_chars
DATABASE_URL=sqlite:///./kivora.db
KIVORA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Gemini AI settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Transactional Email Dispatcher Configuration
# Kivora prioritizes Resend REST API, then standard SMTP, then dev_fallback.
RESEND_API_KEY=your_resend_api_key_here
SENDER_EMAIL=onboarding@resend.dev

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM_EMAIL=your_email@example.com
SMTP_USE_TLS=true

# OAuth 2.0 / OpenID Connect (Google & GitHub)
# Google OAuth 2.0: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000