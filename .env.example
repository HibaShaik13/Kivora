# Kivora Environment Configuration Template
# Copy this file to backend/.env and fill in the values

# Secret key for JWT tokens (Required in production)
SECRET_KEY=your_secure_jwt_secret_key_here

# Environment mode: development, staging, production
KIVORA_ENV=development

# Database URL (SQLite default, or postgresql://user:password@localhost:5432/kivoradb)
DATABASE_URL=sqlite:///./kivora.db

# Google Gemini API Key for AI Brief Builder and Creator Verification evidence analysis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Media upload storage directory
KIVORA_UPLOAD_DIR=uploads

# Gmail SMTP Configuration for OTP Email Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=vu.241fa04495@gmail.com
SMTP_PASSWORD=replace_with_your_16_char_google_app_password
SMTP_FROM_EMAIL=vu.241fa04495@gmail.com
SMTP_FROM_NAME=Kivora Platform
SMTP_USE_TLS=true

# Optional email service (Resend fallback)
RESEND_API_KEY=your_resend_api_key_here
